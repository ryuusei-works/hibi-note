{
  "name": "hibi-sports-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register-tsx.mjs --test tests/*.test.ts tests/*.test.mjs",
    "format": "prettier --write src tests README.md package.json tsconfig.json eslint.config.mjs",
    "format:check": "prettier --check src tests README.md package.json tsconfig.json eslint.config.mjs",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "next": "^16.0.0",
    "parse5": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
